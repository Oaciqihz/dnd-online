# 数据库文件位置（默认 ./data/app.db）
DATABASE_PATH=./data/app.db

# Socket.IO 独立进程端口
SOCKET_PORT=3001

# 浏览器连接 Socket.IO 的地址
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Socket.IO 允许的跨域来源
WEB_ORIGIN=http://localhost:3000

# Next 进程和 Socket 进程之间的内部口令。
# 只校验这个口令，不校验登录 —— 上线前务必换成随机串。
INTERNAL_TOKEN=dev-internal-token

# ------------------------------------------------------------------ 图片存储
#
# 角色立绘存哪。三个选项，改这一个变量就能切：
#   local       存 ./data/uploads（默认，零配置，断网也能开发）
#   cloudinary  存 Cloudinary，需要下面两个值
#   imgbb       存 ImgBB，需要 API Key
#
# 数据库里存的是「能直接用的地址」，所以切换之后老图仍然能显示，
# 不需要迁移数据。
MEDIA_PROVIDER=local

# 本地存储目录（仅 MEDIA_PROVIDER=local 时用）
MEDIA_DIR=./data/uploads

# Cloudinary：控制台 → Settings → Upload → Upload presets，
# 新建一个 Signing Mode = Unsigned 的 preset。
# 注意要的是 preset 名，不是 API Secret —— unsigned 上传不需要密钥。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ImgBB：https://api.imgbb.com/ 免费申请。
# 这个 key 只能待在服务端，绝不能出现在浏览器里。
IMGBB_API_KEY=
